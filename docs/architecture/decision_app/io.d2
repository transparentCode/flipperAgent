direction: right

title: {
  label: "decision_app semantic IO contracts"
  near: top-center
}

classes: {
  source: { style.fill: "#E8F1FF" }
  runtime: { style.fill: "#EEF7EA" }
  contract: { style.fill: "#FFF2D8" }
  storage: { style.fill: "#F4EAFE" }
  boundary: { style.fill: "#FCE8E8" }
  rule: { style.fill: "#F3FAEF" }
}

inputs: {
  label: "Canonical inputs"

  candle: {
    class: source
    label: "ingestion candle\nbar_open_at / bar_close_at\nvenue + instrument + timeframe"
    shape: document
    link: "../../../src/apps/ingestion_app/domain/candle.py"
  }
  lifecycle: {
    class: source
    label: "ingestion lifecycle\nasset availability only"
    shape: document
    link: "../../../src/libs/common/asset_manifest.py"
  }
  config: {
    class: source
    label: "static model catalog\nplugin + lane bindings"
    shape: document
  }
}

runtime: {
  label: "Causal evaluation boundary"

  input_cursor: {
    class: runtime
    label: "InputReadCursor\ncanonical reader position"
  }
  bar_store: {
    class: runtime
    label: "Causal BarStore\ncontinues independent of lanes"
  }
  context: {
    class: contract
    label: "DecisionContext\nmarket_as_of + causal bars\nexternal_data = empty"
    shape: document
    link: "./contracts.md"
  }
  feature_plan: {
    class: runtime
    label: "FeaturePlan\nper-lane history requirements"
  }
  model: {
    class: runtime
    label: "Model plugin\nsynchronous semantic evaluation"
  }
  artifact: {
    class: contract
    label: "ModelArtifact\ntyped analytical result"
    shape: document
  }
  outcome: {
    class: contract
    label: "ModelOutcome\noptional decision + proposed state"
    shape: document
  }
  policy: {
    class: runtime
    label: "DecisionPolicy\nlane-local composition + freshness"
  }
  signal: {
    class: contract
    label: "TradeSignal\nsignal_time = market_as_of\ndecision_ready_at + risk identity"
    shape: document
  }
  lane_commit: {
    class: contract
    label: "LaneCommitWatermark\nper-lane commit position"
    shape: document
  }
  effect_skips: {
    class: contract
    label: "LaneEffectSkips\nstale / restart / foreign-entry ranges"
    shape: document
  }
}

physical: {
  label: "Physical sources and transport"

  timescale: {
    class: storage
    label: "Timescale\ncanonical durable history"
    shape: cylinder
  }
  streams: {
    class: storage
    label: "Valkey\ningestion input + signals:*"
    shape: queue
  }
  decision_db: {
    class: storage
    label: "Decision PostgreSQL\ncheckpoint + effect progress + skip trail"
    shape: cylinder
  }
}

downstream: {
  label: "Consumers"
  risk: {
    class: boundary
    label: "risk_app\nsignal consumer"
  }
  execution: {
    class: boundary
    label: "execution_app\norder consumer"
  }
}

bounds: {
  label: "Runtime deadline and ownership envelope"
  startup: {
    class: rule
    label: "Initial resources + first generation\none absolute 120s deadline"
  }
  wire: {
    class: rule
    label: "Valkey commands + DB acquisition\nnative I/O budget <= 5s"
  }
  database: {
    class: rule
    label: "Canonical history + checkpoint/effect repositories\nSQL / transaction operation <= 15s"
  }
  control: {
    class: rule
    label: "Control admission + effect-task drain\nbounded by 30s"
  }
  cleanup: {
    class: rule
    label: "One lazy aggregate cleanup budget <= 5s"
  }
  ownership: {
    class: boundary
    label: "STOPPED = owned task quiescence\nunconfirmed resource release is retained/fenced"
  }
}

inputs.candle -> runtime.input_cursor: "observed canonical candle"
inputs.lifecycle -> runtime.context: "asset availability"
inputs.config -> runtime.context: "resolved lane/binding"
runtime.input_cursor -> runtime.bar_store: "append accepted observation"
runtime.bar_store -> runtime.context: "causal views"
physical.timescale -> runtime.bar_store: "startup / reconstruction history"
runtime.context -> runtime.feature_plan: "compiled requirements"
runtime.feature_plan -> runtime.model: "shared feature values"
runtime.context -> runtime.model: "complete causal DecisionContext"
runtime.model -> runtime.artifact: "analytical artifact"
runtime.model -> runtime.outcome: "decision + proposed next state"
runtime.artifact -> runtime.policy: "upstream artifact"
runtime.outcome -> runtime.policy: "binding outcome"
runtime.policy -> runtime.signal: "fresh result or no-signal disposition"
runtime.signal -> physical.streams: "signals:*"
runtime.signal -> runtime.lane_commit: "publication success + state commit"
runtime.lane_commit -> physical.decision_db: "checkpoint / latest effect progress"
runtime.policy -> runtime.effect_skips: "stale publication suppressed"
runtime.effect_skips -> physical.decision_db: "idempotent append-only range"
physical.streams -> downstream.risk: "live signal transport"
downstream.risk -> downstream.execution: "orders"

inputs.config -> bounds.startup: "approved defaults from configs/decision/global.yaml"
bounds.startup -> runtime.input_cursor: "install after bounded startup"
physical.streams -> bounds.wire: "Valkey command"
physical.timescale -> bounds.wire: "DB acquisition"
bounds.wire -> bounds.database: "remaining operation budget"
physical.decision_db -> bounds.database: "state/effect transactions"
bounds.startup -> bounds.cleanup: "startup failure path"
bounds.database -> bounds.cleanup: "rollback / release on expiry"
bounds.control -> bounds.cleanup: "drain before cleanup clock"
bounds.cleanup -> bounds.ownership: "confirmed release or fail-closed fence"

rules: {
  label: "Non-negotiable semantics"
  causal: {
    class: rule
    label: "market_as_of is causal cutoff\nrepresented end <= cutoff"
  }
  state: {
    class: rule
    label: "publish / no-signal / explicit skip\ncommit state before lane watermark"
  }
  progress: {
    class: rule
    label: "InputReadCursor + BarStore continue\nlane failure cannot block unrelated lanes"
  }
  freshness: {
    class: rule
    label: "SIGNAL and shadow age <= 300s\notherwise commit skip; no publication"
  }
  replay: {
    class: rule
    label: "startup state reconstruction suppresses publication\nexternal data runtime is inactive"
  }
}

runtime.context -> rules.causal: "must satisfy"
runtime.outcome -> rules.state: "must satisfy"
runtime.bar_store -> rules.progress: "independent progress"
runtime.policy -> rules.freshness: "before publication"
runtime.effect_skips -> rules.replay: "durable skip trail"

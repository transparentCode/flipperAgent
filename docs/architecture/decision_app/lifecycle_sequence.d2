direction: right

title: {
  label: "decision_app startup, skip-forward, live, recovery, and shutdown"
  near: top-center
}

classes: {
  step: { style.fill: "#EEF7EA" }
  gate: { style.fill: "#FFF2D8" }
  failure: { style.fill: "#FCE8E8" }
  source: { style.fill: "#E8F1FF" }
  terminal: { style.fill: "#F4EAFE" }
}

startup: {
  label: "1. Restart: validate, probe, skip forward"
  resolve: {
    class: step
    label: "Resolve streams + static lane plan\nR = latest retained trigger cutoff"
  }
  history: {
    class: gate
    label: "Validate each lane history window at R\nNo search backward for an older ready cutoff"
  }
  probe: {
    class: gate
    label: "XRANGE exact first-unaccounted ID X\nReconcile matching effect; foreign ID => skip"
  }
  stateless: {
    class: step
    label: "Stateless: skip remaining (P, R)\nR is the only live candidate"
  }
  stateful: {
    class: step
    label: "Stateful: publication-free rewarm\ncheckpoint+d / init horizon through R"
  }
  skip_trail: {
    class: terminal
    label: "Persist compact skip range\nlatest effect progress uses NULL disposition"
  }
  ready: {
    class: gate
    label: "Install generation after history + state validation"
  }
}

live: {
  label: "2. Live cutoff transaction"
  candle: {
    class: source
    label: "ingestion closed candle"
  }
  append: {
    class: step
    label: "InputReadCursor accepts\nappend to causal BarStore"
  }
  evaluate: {
    class: step
    label: "Features -> same-lane models\n-> DecisionPolicy"
  }
  freshness: {
    class: gate
    label: "Authoritative SIGNAL / any shadow\nready age <= 300s?"
  }
  publish: {
    class: step
    label: "Publish idempotently\nor commit NO_SIGNAL"
  }
  stale: {
    class: step
    label: "Commit proposed state + watermark\nrecord stale skip; publish nothing"
  }
  progress: {
    class: terminal
    label: "Persist checkpoint / effect progress\nappend-only skip evidence when skipped"
  }
}

recovery: {
  label: "3. Forward input gap: one durable reconstruction"
  continuous: {
    class: step
    label: "Continuous stream after interruption\nresume existing InputReadCursor"
  }
  gap: {
    class: gate
    label: "Exact RECONSTRUCTION_REQUIRED\nreason = forward canonical market gap"
  }
  fence: {
    class: failure
    label: "Fence old generation\nno further poll/evaluation"
  }
  rebuild: {
    class: step
    label: "INPUT_RECONSTRUCTION\nnormal D9A startup from Timescale + checkpoints"
  }
  install: {
    class: terminal
    label: "Fresh tails + reconstructed state\ninstall replacement before reads resume"
  }
  other: {
    class: failure
    label: "Generic reconstruction / malformed / conflict\nremain fail-closed; no input auto-rebuild"
  }
}

shutdown: {
  label: "4. Controlled shutdown"
  stop_inputs: {
    class: step
    label: "Stop live reads\nstop new evaluations"
  }
  flush: {
    class: gate
    label: "Finish / cancel bounded work\nwithout stale publication"
  }
  stop: {
    class: terminal
    label: "Close runtime\nrelease owned resources"
  }
}

bounded: {
  label: "5. Shared deadline and ownership envelope"
  startup: {
    class: gate
    label: "Startup + first generation\none absolute 120s deadline"
  }
  control: {
    class: gate
    label: "Control admission + drain\n30s before cleanup begins"
  }
  cleanup: {
    class: terminal
    label: "Aggregate 5s teardown\nowned resources only"
  }
  fence: {
    class: failure
    label: "Unconfirmed release\nretain ownership and fence reuse"
  }
}

startup.resolve -> startup.history: "cutoff R"
startup.history -> startup.probe: "complete causal history"
startup.probe -> startup.stateless: "probe P+d or R"
startup.probe -> startup.stateful: "probe P+d or R"
startup.stateless -> startup.skip_trail: "record restart / foreign skip range"
startup.stateful -> startup.skip_trail: "record restart_rewarm range"
startup.skip_trail -> startup.ready: "progress reconciled"
startup.stateless -> startup.ready: "R pending only when not already accounted"
startup.stateful -> startup.ready: "resume at R + trigger duration"

live.candle -> live.append: "closed event"
live.append -> live.evaluate: "causal cutoff ready"
live.evaluate -> live.freshness: "SIGNAL / shadow age"
live.freshness -> live.publish: "fresh; NO_SIGNAL remains ordinary"
live.freshness -> live.stale: "stale"
live.publish -> live.progress: "effect committed"
live.stale -> live.progress: "skip + state committed"

recovery.continuous -> live.append: "continue old cursor"
recovery.continuous -> recovery.gap: "next input result"
recovery.gap -> recovery.fence: "proven forward gap"
recovery.gap -> recovery.other: "all other failure classes"
recovery.fence -> recovery.rebuild: "request one rebuild"
recovery.rebuild -> startup.resolve: "existing generation factory"
startup.ready -> recovery.install: "replacement startup-ready"
recovery.install -> live.candle: "normal reads resume"

shutdown.stop_inputs -> shutdown.flush: "admission closed"
shutdown.flush -> shutdown.stop: "quiescent"
bounded.startup -> startup.resolve: "absolute startup budget"
bounded.control -> bounded.cleanup: "drain before cleanup clock"
shutdown.stop -> bounded.cleanup: "owned teardown"
bounded.cleanup -> bounded.fence: "release unconfirmed"

direction: right

title: {
  label: "decision_app D0 architecture with DA-2 skip-forward"
  near: top-center
}

sources: {
  label: "Authoritative inputs"
  style.fill: "#E8F1FF"

  ingestion: {
    label: "ingestion\ncanonical OHLCV + lifecycle"
    link: "../ingestion_app/README.md"
    shape: package
  }

  config: {
    label: "configs/decision\nstatic catalog + policy"
    shape: document
  }
}

decision_app: {
  label: "decision_app\none runtime / in-process plugins"
  style.fill: "#EEF7EA"
  link: "./README.md"

  input: { label: "InputReadCursor\ncanonical reader position" }
  bar_store: { label: "Causal BarStore\nshared bounded views" }
  readiness: { label: "Lane readiness\ncausal cutoff checks" }
  feature_plan: { label: "FeaturePlan\nper-lane history" }
  model_plan: { label: "Model execution plan\nstatic same-lane topology" }
  policy: { label: "DecisionPolicy\n300s freshness gate" }
  publication: { label: "Publication\ndeterministic identity / conflict gate" }
  lane_commit: { label: "LaneCommitWatermark\nper-lane commit position" }
  effect_skips: { label: "LaneEffectSkips\nappend-only compact skip ranges" }
  deadline_envelope: {
    label: "Approved defaults from configs/decision/global.yaml\nstartup 120s | I/O 5s | DB 15s\ncontrol 30s | aggregate cleanup 5s"
  }
}

storage: {
  label: "Durable and hot state"
  style.fill: "#F4EAFE"

  timescale: {
    label: "Timescale\ningestion.candles\ncausal history authority"
    shape: cylinder
  }
  valkey: {
    label: "Valkey\ncanonical input + signal transport"
    shape: cylinder
  }
  decision_db: {
    label: "Decision PostgreSQL\ncheckpoints + effect progress + skip trail"
    shape: cylinder
  }
}

downstream: {
  label: "Downstream boundaries"
  style.fill: "#FCE8E8"

  risk: {
    label: "risk_app\nsignal / risk policy"
    shape: package
  }
  execution: {
    label: "execution_app\norders and fills"
    shape: package
  }
  price_note: {
    label: "Decision does not publish price_update:*\nRisk price continuity is a separate downstream contract"
    shape: document
  }
}

sources.ingestion -> decision_app.input: "closed canonical candles"
sources.ingestion -> decision_app.readiness: "manifest / lifecycle authority"
sources.config -> decision_app.readiness: "static lane catalog"
sources.config -> decision_app.deadline_envelope: "runtime bounds"

decision_app.input -> decision_app.bar_store: "append accepted observation"
decision_app.bar_store -> decision_app.readiness: "causal views / observed cutoffs"
decision_app.readiness -> decision_app.feature_plan: "ready cutoff"
decision_app.feature_plan -> decision_app.model_plan: "feature values"
decision_app.model_plan -> decision_app.policy: "artifacts / decisions"
decision_app.policy -> decision_app.publication: "fresh authoritative result"
decision_app.publication -> storage.valkey: "signals:*"
decision_app.publication -> decision_app.lane_commit: "publication / no-signal + state commit"
decision_app.policy -> decision_app.effect_skips: "stale effect / restart skip"
decision_app.lane_commit -> storage.decision_db: "checkpoint + latest effect progress"
decision_app.effect_skips -> storage.decision_db: "idempotent skip ranges"
decision_app.deadline_envelope -> decision_app.input: "bounded install / live ownership"
storage.valkey -> downstream.risk: "signals:*"
downstream.risk -> downstream.execution: "orders"
storage.timescale -> decision_app.bar_store: "startup / generation reconstruction"
downstream.price_note -> downstream.risk: "separate feed authority"

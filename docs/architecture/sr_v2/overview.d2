direction: down

title: {
  label: "IMPLEMENTED BASE / RESEARCH ONLY\nArchitecture record · no deployment or promotion claim\nSR v2 structural research HLD"
  near: top-center
}

authorities: {
  label: "[EXISTING] Resolved YAML authorities\nmodel · trial · notebook policy"
  style.fill: "#E8F1FF"
}

source: {
  label: "[RESEARCH-ONLY · EXISTING] Authenticated source set\nBinanceUSDMResearchLoader → SourceBarRecord\n→ ResearchSourceSetManifest"
  style.fill: "#E8F1FF"
}

offline: {
  label: "[EXISTING] OfflineCompute.run\ncaller-supplied closed SRBar windows"
  style.fill: "#EEF7EA"
}


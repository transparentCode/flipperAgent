quality: {
  label: "Quality / Safety"
  style.fill: "#EAF7F0"

  validator: {
    label: "candle_validator"
    link: "../../../src/apps/ingestion_app/runtime/websocket.py"
  }
}

observability: {
  label: "Observability"
  style.fill: "#F8F1E8"

  metrics: {
    label: "Prometheus metrics"
  }

  dashboards: {
    label: "Grafana dashboards"
  }

  logs: {
    label: "Loki / structured logs"
  }

  alerts: {
    label: "future alerting"
  }
}

contracts: {
  label: "Explicit Contracts"
  style.fill: "#F3FAEF"

  truth: {
    label: "canonical truth\nTimescaleDB `ingestion_assets` = only durable owner\nValkey = runtime projection + streams\nnever dual-write independent truth"
  }

  idempotency: {
    label: "lifecycle idempotency\nrequest_id\ncommand_id\nasset_version\ntimeframe_version\nreplay must converge to one runtime + one backfill"
  }

  recovery: {
    label: "recovery rules\nWS disconnect/restart -> WARMING\nrecover from last persisted closed candle + overlap\ndedupe duplicate candle\npromote LIVE only after parity restored"
  }

  candle_contract: {
    label: "candle finality\nclosed = default downstream trigger\nforming/provisional stays internal or opt-in\ncorrected_closed = explicit repair signal"
  }

  parity: {
    label: "backtest/live parity\nsame stored OHLCV semantics\nsame close timestamp convention\nsame finality + correction policy\nsource precedence is explicit"
  }
}

inputs.api_client -> ingestion_app.ingress_routes: "HTTP"
ingestion_app.runtime_process -> ingestion_app.runtime_app: "boot"
inputs.binance_ws -> ingestion_app.websocket_pipeline: "live candles"
inputs.binance_rest -> ingestion_app.queue_worker: "backfill / depth"
inputs.api_client -> ingestion_app.scraper_bridge: "on-demand scraper routes"
ingestion_app.scraper_bridge -> inputs.scraper_app: "internal HTTP"

ingestion_app.ingress_routes -> ingestion_app.control_plane: "asset lifecycle"
ingestion_app.control_plane -> timescaledb.ingestion_assets: "persist desired state"
ingestion_app.control_plane -> valkey.manifest_asset: "sync canonical asset"
ingestion_app.control_plane -> valkey.manifest_tf: "sync canonical asset/timeframe"
ingestion_app.control_plane -> valkey.lifecycle: "publish lifecycle"
ingestion_app.control_plane -> valkey.control_stream: "publish runtime commands"
ingestion_app.control_plane -> valkey.events_stream: "publish accepted events"
ingestion_app.control_plane -> contracts.truth: "owns durable registry rule"
ingestion_app.control_plane -> contracts.idempotency: "must converge repeated requests"

ingestion_app.runtime_app -> ingestion_app.runtime_reconciler: "lifespan / reconcile loop"
timescaledb.ingestion_assets -> ingestion_app.runtime_reconciler: "effective catalog"
valkey.control_stream -> ingestion_app.runtime_reconciler: "change trigger"
ingestion_app.runtime_reconciler -> ingestion_app.websocket_pipeline: "start / stop runtimes"
ingestion_app.runtime_reconciler -> valkey.runtime_state: "warming / live / cold state"
ingestion_app.runtime_reconciler -> valkey.arq_jobs: "purge / backfill jobs"
ingestion_app.runtime_reconciler -> contracts.recovery: "enforces bootstrap/resume rules"

ingestion_app.websocket_pipeline -> quality.validator: "validate candle semantics"
quality.validator -> timescaledb.ohlcv: "persist canonical candle"
quality.validator -> valkey.ohlcv_stream: "publish closed candles only"
ingestion_app.websocket_pipeline -> valkey.runtime_state: "state / liveness"
quality.validator -> contracts.candle_contract: "enforces finality contract"
quality.validator -> contracts.parity: "keeps live semantics aligned"

ingestion_app.queue_worker -> timescaledb.ohlcv: "gap-fill / top-up writes"
ingestion_app.queue_worker -> timescaledb.l2_depth_features: "depth writes"
ingestion_app.queue_worker -> valkey.events_stream: "purge / failure events"
ingestion_app.queue_worker -> valkey.dlq_stream: "non-recoverable failures (target)"
ingestion_app.queue_worker -> contracts.recovery: "repairs gaps before LIVE"

ingestion_app.websocket_pipeline -> observability.metrics: "lag / latency / restart metrics"
ingestion_app.queue_worker -> observability.logs: "job outcomes"
valkey.events_stream -> observability.alerts: "future alerts"
valkey.dlq_stream -> observability.alerts: "terminal failure signal"

valkey.lifecycle -> downstream.signal_app: "subscribe"
valkey.lifecycle -> downstream.strategy_app: "subscribe"
valkey.ohlcv_stream -> downstream.signal_app: "consume"
downstream.signal_app -> downstream.strategy_app: "features / triggers"
downstream.strategy_app -> downstream.risk_app: "proposed trades"
downstream.risk_app -> downstream.execution_app: "approved orders"

direction: right

title: {
  label: "ingestion_app architecture"
  near: top-center
}

inputs: {
  label: "Inputs / Control"
  style.fill: "#E8F1FF"

  config: {
    label: "configs/ingestion\nglobal + per-asset YAML"
    shape: document
    link: "../../../configs/ingestion/global.yaml"
  }

  api_client: {
    label: "operator / api_app"
    link: "../../../src/apps/ingestion_app/api/routes.py"
  }

  binance_ws: {
    label: "Binance Futures WS"
    link: "../../../src/apps/ingestion_app/runtime/websocket.py"
  }

  historical: {
    label: "Binance REST + CCXT"
    link: "../../../src/apps/ingestion_app/providers/base.py"
  }
}

ingestion_app: {
  label: "ingestion_app"
  style.fill: "#EEF7EA"
  link: "./README.md"

  main: {
    label: "main / FastAPI bootstrap"
    link: "../../../src/apps/ingestion_app/main.py"
  }

  settings: {
    label: "typed settings"
    link: "../../../src/apps/ingestion_app/settings.py"
  }

  provider_factory: {
    label: "provider factory\nvalidate + construct"
    link: "../../../src/apps/ingestion_app/providers/factory.py"
  }

  rest_decoder: {
    label: "Binance REST row decoders\nadapter-specific order"
    link: "../../../src/apps/ingestion_app/providers/binance_rest.py"
  }

  api: {
    label: "control API"
    link: "../../../src/apps/ingestion_app/api/routes.py"
  }

  config_service: {
    label: "AssetConfigService"
    link: "../../../src/apps/ingestion_app/services/config_reconciliation.py"
  }

  controller: {
    label: "RuntimeController"
    link: "../../../src/apps/ingestion_app/runtime/controller.py"
  }

  controller_checkpoint: {
    label: "_RuntimeCheckpoint\nsettings + intent + started + error"
    link: "../../../src/apps/ingestion_app/runtime/controller.py"
  }

  controller_transition: {
    label: "_stop_for_transition\nstop -> quarantine check -> detach"
    link: "../../../src/apps/ingestion_app/runtime/controller.py"
  }

  supervisor: {
    label: "RuntimeSupervisor"
    link: "../../../src/apps/ingestion_app/runtime/supervisor.py"
  }

  lane_resolution: {
    label: "_resolve_lane_contexts(settings, provider)\npure lane/config helper"
    link: "../../../src/apps/ingestion_app/runtime/supervisor.py"
  }

  supervisor_cycle: {
    label: "_run_live_or_interruption_cycle\ncommon failure boundary"
    link: "../../../src/apps/ingestion_app/runtime/supervisor.py"
  }

  websocket: {
    label: "BinanceWebSocketManager"
    link: "../../../src/apps/ingestion_app/runtime/websocket.py"
  }

  websocket_decoder: {
    label: "Binance websocket\npayload decoder"
    link: "../../../src/apps/ingestion_app/runtime/binance_websocket_decode.py"
  }

  recovery: {
    label: "RecoveryEngine"
    link: "../../../src/apps/ingestion_app/services/recovery.py"
  }

  ingestion_service: {
    label: "CandleIngestionService"
    link: "../../../src/apps/ingestion_app/services/candle_ingestion.py"
  }

  htf: {
    label: "HTFAggregationService"
    link: "../../../src/apps/ingestion_app/services/htf_aggregation.py"
  }

  repository: {
    label: "CandleRepository"
    link: "../../../src/apps/ingestion_app/storage/repository.py"
  }

  publisher: {
    label: "OutboxPublisher"
    link: "../../../src/apps/ingestion_app/publication/publisher.py"
  }

  lifecycle: {
    label: "AssetLifecycleReconciler"
    link: "../../../src/apps/ingestion_app/services/asset_lifecycle.py"
  }

  retention: {
    label: "RetentionJanitor"
    link: "../../../src/apps/ingestion_app/services/retention.py"
  }

  observability: {
    label: "observability"
    link: "../../../src/apps/ingestion_app/observability.py"
  }
}

timescale: {
  label: "TimescaleDB — historical authority"
  style.fill: "#F4EAFE"

  candles: {
    label: "ingestion.candles\ncanonical OHLCV hypertable"
    shape: cylinder
    link: "../../../src/apps/ingestion_app/storage/schema.sql"
  }

  outbox: {
    label: "ingestion.outbox\ndurable publication intents"
    shape: cylinder
    link: "../../../src/apps/ingestion_app/storage/schema.sql"
  }
}

valkey: {
  label: "Valkey — bounded transport / runtime projection"
  style.fill: "#FFF2D8"

  ohlcv: {
    label: "stream:ohlcv:ingestion:{venue}:{instrument_id}:{tf}"
    shape: queue
    link: "../../../src/apps/ingestion_app/publication/stream_keys.py"
  }

  asset_manifest: {
    label: "asset:{symbol}\nasset:{symbol}:tf:{tf}"
    shape: stored_data
    link: "../../../src/libs/common/asset_manifest.py"
  }

  lifecycle_stream: {
    label: "asset:lifecycle"
    shape: queue
    link: "../../../src/libs/common/asset_manifest.py"
  }
}

downstream: {
  label: "Downstream"
  style.fill: "#FCE8E8"

  signal_app: {
    label: "signal_app"
    link: "../signal_app/README.md"
  }

  alert_app: {
    label: "alert_app lifecycle consumer"
    link: "../alert_app/README.md"
  }
}

ops: {
  label: "Operations"
  style.fill: "#F8F1E8"

  metrics: { label: "OTEL / Prometheus" }
  grafana: { label: "Grafana ingestion" }
  logs: { label: "structured logs / Loki" }
}

inputs.config -> ingestion_app.settings: "validate"
inputs.api_client -> ingestion_app.api: "HTTP control"
inputs.binance_ws -> ingestion_app.websocket: "finalized 1m candles"
inputs.historical -> ingestion_app.rest_decoder: "raw historical rows"
ingestion_app.rest_decoder -> ingestion_app.recovery: "provider observations"

ingestion_app.main -> ingestion_app.settings: "load"
ingestion_app.main -> ingestion_app.provider_factory: "validate / construct"
ingestion_app.provider_factory -> ingestion_app.recovery: "owned historical providers"
ingestion_app.main -> ingestion_app.controller: "compose/start"
ingestion_app.main -> ingestion_app.publisher: "background task"
ingestion_app.main -> ingestion_app.lifecycle: "broker-bound projection"
ingestion_app.main -> ingestion_app.retention: "background janitor"
ingestion_app.api -> ingestion_app.config_service: "create / patch asset"
ingestion_app.api -> ingestion_app.controller: "pause / resume / reconnect / recover"
ingestion_app.config_service -> ingestion_app.settings: "reload candidate"
ingestion_app.config_service -> ingestion_app.controller: "replace settings"
ingestion_app.config_service -> ingestion_app.lifecycle: "mark asset dirty"
ingestion_app.controller -> ingestion_app.supervisor: "fresh supervisor"
ingestion_app.controller -> ingestion_app.controller_checkpoint: "checkpoint replace/recover"
ingestion_app.controller_checkpoint -> ingestion_app.controller_transition: "ordered transition"
ingestion_app.controller_transition -> ingestion_app.supervisor: "stop + post-stop check; detach"
ingestion_app.supervisor -> ingestion_app.recovery: "startup / interruption recovery"
ingestion_app.settings -> ingestion_app.lane_resolution: "typed enabled lanes"
ingestion_app.lane_resolution -> ingestion_app.supervisor: "contexts + subscriptions"
ingestion_app.supervisor -> ingestion_app.supervisor_cycle: "run loop"
ingestion_app.supervisor_cycle -> ingestion_app.supervisor: "control cancel / deadline / error"
ingestion_app.supervisor -> ingestion_app.websocket: "live stream"
ingestion_app.websocket -> ingestion_app.websocket_decoder: "raw finalized payload"
ingestion_app.websocket_decoder -> ingestion_app.supervisor: "CandleObservation"
ingestion_app.supervisor -> ingestion_app.ingestion_service: "commit base candle"
ingestion_app.supervisor -> ingestion_app.htf: "derive / reconcile HTFs"
ingestion_app.recovery -> ingestion_app.ingestion_service: "recovered base candles"
ingestion_app.recovery -> ingestion_app.htf: "affected HTF closure"
ingestion_app.ingestion_service -> ingestion_app.repository: "canonical commit"
ingestion_app.htf -> ingestion_app.repository: "read constituents"
ingestion_app.htf -> ingestion_app.ingestion_service: "commit derived candle"
ingestion_app.publisher -> ingestion_app.repository: "read pending / mark published"
ingestion_app.retention -> ingestion_app.repository: "published outbox cleanup / drop chunks"

ingestion_app.repository -> timescale.candles: "read / write"
ingestion_app.repository -> timescale.outbox: "atomic outbox write"
timescale.outbox -> ingestion_app.publisher: "pending rows"
ingestion_app.publisher -> valkey.ohlcv: "XADD at least once"
ingestion_app.lifecycle -> valkey.asset_manifest: "project config state"
ingestion_app.lifecycle -> valkey.lifecycle_stream: "publish transition"
valkey.ohlcv -> downstream.signal_app: "consume"
valkey.lifecycle_stream -> downstream.signal_app: "consume"
valkey.lifecycle_stream -> downstream.alert_app: "consume"
timescale.candles -> downstream.signal_app: "history priming / recovery"

ingestion_app.observability -> ops.metrics: "measure"
ops.metrics -> ops.grafana: "visualize"
ingestion_app.main -> ops.logs: "structured logs"

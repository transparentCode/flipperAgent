  binance_ws: {
    label: "Binance WS"
    link: "../../../src/apps/ingestion_app/adapters/binance_native.py"
  }

  binance_rest: {
    label: "Binance REST / CCXT"
    link: "../../../src/apps/ingestion_app/adapters/crypto_ccxt.py"
  }

  scraper_app: {
    label: "scraper_app"
    link: "../../../src/apps/scraper_app/api/app.py"
  }
}

ingestion_app: {
  label: "ingestion_app"
  style.fill: "#EEF7EA"
  link: "./README.md"

  ingress_routes: {
    label: "ingestion_router"
    link: "../../../src/apps/api_app/routers/ingestion.py"
  }

  control_plane: {
    label: "control_plane"
    link: "../../../src/apps/ingestion_app/control_plane/service.py"
  }

  runtime_reconciler: {
    label: "runtime_reconciler"
    link: "../../../src/apps/ingestion_app/runtime/reconciler.py"
  }

  websocket_pipeline: {
    label: "websocket_pipeline"
    link: "../../../src/apps/ingestion_app/runtime/websocket.py"
  }

  queue_worker: {
    label: "queue_jobs"
    link: "../../../src/apps/ingestion_app/worker.py"
  }

  scraper_bridge: {
    label: "scraper_bridge"
    link: "../../../src/apps/api_app/clients/scraper_service.py"
  }
}

valkey: {
  label: "Valkey"
  style.fill: "#FFF2D8"

  manifest_asset: {
    label: "asset:{symbol}"
    link: "../../../src/libs/common/asset_manifest.py"
  }

  manifest_tf: {
    label: "asset:{symbol}:tf:{tf}"
    link: "../../../src/libs/common/asset_manifest.py"
  }

  lifecycle: {
    label: "asset:lifecycle"
    link: "../../../src/libs/common/asset_manifest.py"
  }

  control_stream: {
    label: "stream:control:ingestion"
    link: "../../../src/apps/ingestion_app/control_plane/publisher.py"
  }

  events_stream: {
    label: "stream:events:ingestion"
    link: "../../../src/apps/ingestion_app/control_plane/publisher.py"
  }

  ohlcv_stream: {
    label: "stream:ohlcv:{symbol}:{tf}"
    link: "../../../src/apps/ingestion_app/runtime/websocket.py"
  }

  runtime_state: {
    label: "ingestion:state:{symbol}:{tf}"
    link: "../../../src/apps/ingestion_app/coordination.py"
  }

  arq_jobs: {
    label: "ARQ jobs"
    link: "../../../src/apps/ingestion_app/worker.py"
  }
}

timescaledb: {
  label: "TimescaleDB"
  style.fill: "#F4EAFE"

  ingestion_assets: {
    label: "ingestion_assets"
    link: "../../../src/apps/ingestion_app/storage/schema.sql"
  }

  ohlcv: {
    label: "ohlcv"
    link: "../../../src/apps/ingestion_app/storage/schema.sql"
  }

  l2_depth_features: {
    label: "l2_depth_features"
    link: "../../../src/apps/ingestion_app/storage/schema.sql"
  }
}

downstream: {
  label: "Downstream"
  style.fill: "#FCE8E8"

  signal_app: {
    label: "signal_app"
    link: "../signal_app/README.md"
  }

  strategy_app: {
    label: "strategy_app"
    link: "../strategy_app/README.md"
  }
}

inputs.api_client -> ingestion_app.ingress_routes: "HTTP"
inputs.binance_ws -> ingestion_app.websocket_pipeline: "live candles"
inputs.binance_rest -> ingestion_app.queue_worker: "backfill / depth"
inputs.api_client -> ingestion_app.scraper_bridge: "on-demand scraper routes"
ingestion_app.scraper_bridge -> inputs.scraper_app: "internal HTTP"

ingestion_app.ingress_routes -> ingestion_app.control_plane: "asset lifecycle"
ingestion_app.control_plane -> timescaledb.ingestion_assets: "persist desired state"
ingestion_app.control_plane -> valkey.manifest_asset: "sync canonical asset"
ingestion_app.control_plane -> valkey.manifest_tf: "sync canonical asset/timeframe"
ingestion_app.control_plane -> valkey.lifecycle: "publish lifecycle"
ingestion_app.control_plane -> valkey.control_stream: "publish runtime commands"
ingestion_app.control_plane -> valkey.events_stream: "publish accepted events"

timescaledb.ingestion_assets -> ingestion_app.runtime_reconciler: "effective catalog"
valkey.control_stream -> ingestion_app.runtime_reconciler: "change trigger"
ingestion_app.runtime_reconciler -> ingestion_app.websocket_pipeline: "start / stop runtimes"
ingestion_app.runtime_reconciler -> valkey.arq_jobs: "purge / backfill jobs"

ingestion_app.websocket_pipeline -> timescaledb.ohlcv: "persist live bars"
ingestion_app.websocket_pipeline -> valkey.ohlcv_stream: "publish closed candles"
ingestion_app.websocket_pipeline -> valkey.runtime_state: "state / liveness"

ingestion_app.queue_worker -> timescaledb.ohlcv: "gap-fill / top-up writes"
ingestion_app.queue_worker -> timescaledb.l2_depth_features: "depth writes"
ingestion_app.queue_worker -> valkey.events_stream: "purge / failure events"

valkey.lifecycle -> downstream.signal_app: "subscribe"
valkey.lifecycle -> downstream.strategy_app: "subscribe"
valkey.ohlcv_stream -> downstream.signal_app: "consume"

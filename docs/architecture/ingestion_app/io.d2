direction: right

title: {
  label: "ingestion_app IO contracts"
  near: top-center
}

classes: {
  source: { style.fill: "#E8F1FF" }
  component: { style.fill: "#EEF7EA" }
  contract: { style.fill: "#FFF2D8" }
  storage: { style.fill: "#F4EAFE" }
  consumer: { style.fill: "#FCE8E8" }
  control: { style.fill: "#EAF7F0" }
  rule: { style.fill: "#F3FAEF" }
}

sources: {
  label: "Inputs"

  lifecycle_request: {
    class: source
    label: "asset lifecycle request"
    shape: document
    link: "../../../src/apps/ingestion_app/models/asset_registry.py"
  }

  live_feed: {
    class: source
    label: "Binance live kline"
    link: "../../../src/apps/ingestion_app/adapters/binance_native.py"
  }

  historical_feed: {
    class: source
    label: "historical OHLCV / depth"
    link: "../../../src/apps/ingestion_app/adapters/crypto_ccxt.py"
  }
}

components: {
  label: "Components"

  router: {
    class: component
    label: "ingestion_router"
    link: "../../../src/apps/api_app/routers/ingestion.py"
  }

  runtime_app: {
    class: component
    label: "runtime_app"
    link: "../../../src/apps/ingestion_app/runtime/app.py"
  }

  control: {
    class: component
    label: "control_plane"
    link: "../../../src/apps/ingestion_app/control_plane/service.py"
  }

  reconciler: {
    class: component
    label: "runtime_reconciler"
    link: "../../../src/apps/ingestion_app/runtime/reconciler.py"
  }

  ws: {
    class: component
    label: "websocket_pipeline"
    link: "../../../src/apps/ingestion_app/runtime/websocket.py"
  }

  jobs: {
    class: component
    label: "queue_jobs"
    link: "../../../src/apps/ingestion_app/worker.py"
  }

  validator: {
    class: component
    label: "candle_validator"
    link: "../../../src/apps/ingestion_app/runtime/websocket.py"
  }
}

contracts: {
  label: "Valkey / Job Contracts"

  asset_manifest: {
    class: contract
    label: "asset:{symbol}\nprojection"
    shape: stored_data
  }

  asset_manifest_tf: {
    class: contract
    label: "asset:{symbol}:tf:{tf}\nprojection"
    shape: stored_data
  }

  lifecycle_stream: {
    class: contract
    label: "asset:lifecycle"
    shape: queue
  }

  control_stream: {
    class: contract
    label: "stream:control:ingestion"
    shape: queue
  }

  events_stream: {
    class: contract
    label: "stream:events:ingestion"
    shape: queue
  }

  dlq_stream: {
    class: contract
    label: "stream:dlq:ingestion (target)"
    shape: queue
  }

  ohlcv_stream: {
    class: contract
    label: "stream:ohlcv:{symbol}:{tf}"
    shape: queue
  }

  runtime_state: {
    class: contract
    label: "ingestion:state:{symbol}:{tf}"
    shape: stored_data
  }

  gap_fill_job: {
    class: contract
    label: "run_rest_gap_fill"
    shape: queue
  }

  topup_job: {
    class: contract
    label: "poll_binance_ohlcv"
    shape: queue
  }

  depth_job: {
    class: contract
    label: "poll_l2_depth"
    shape: queue
  }

  purge_job: {
    class: contract
    label: "purge_removed_asset"
    shape: queue
  }
}

rules: {
  label: "Operating Rules"

  truth_policy: {
    class: rule
    label: "truth policy\nTimescaleDB `ingestion_assets` = canonical durable registry\nValkey keys/streams = projection + transport\nnever independent dual truth"
  }

  idempotency_policy: {
    class: rule
    label: "idempotency policy\nrequest_id\ncommand_id\nasset_version\ntimeframe_version\nsame request must converge to one runtime + one backfill"
  }

  recovery_policy: {
    class: rule
    label: "recovery policy\ndisconnect/restart/late/duplicate/REST-vs-WS mismatch\ngap-fill from last persisted closed candle + overlap\nmust recover before LIVE"
  }

  candle_policy: {
    class: rule
    label: "candle policy\nclosed only by default for downstream\nforming candle stays internal or opt-in\ncorrected_closed explicit"
  }

  parity_policy: {
    class: rule
    label: "parity policy\nhistorical and live share close timestamp/finality/correction semantics"
  }
}

storage: {
  label: "Persistence"

  ingestion_assets: {
    class: storage
    shape: cylinder
    label: "ingestion_assets\ncanonical"
  }

  ohlcv: {
    class: storage
    shape: cylinder
    label: "ohlcv"
  }

  l2: {
    class: storage
    shape: cylinder
    label: "l2_depth_features"
  }

  failures: {
    class: storage
    shape: cylinder
    label: "ingestion_failures (target)\ndurable terminal failure sink"
  }
}

consumers: {
  label: "Consumers"

  signal_app: {
    class: consumer
    label: "signal_app"
  }

  strategy_app: {
    class: consumer
    label: "strategy_app"
  }

  risk_app: {
    class: consumer
    label: "risk_app (target)"
  }

  execution_app: {
    class: consumer
    label: "execution_app (target)"
  }

  operators: {
    class: consumer
    label: "operators / future alert_app"
  }
}

sources.lifecycle_request -> components.router: "HTTP"
components.router -> components.control: "upsert / patch / action"
components.runtime_app -> components.reconciler: "startup reconcile"
sources.live_feed -> components.ws: "websocket"
sources.historical_feed -> components.jobs: "REST"

components.control -> storage.ingestion_assets: "persist registry"
storage.ingestion_assets -> contracts.asset_manifest: "project canonical state"
components.control -> contracts.asset_manifest: "write"
components.control -> contracts.asset_manifest_tf: "write"
components.control -> contracts.lifecycle_stream: "publish"
components.control -> contracts.control_stream: "publish"
components.control -> contracts.events_stream: "publish"
components.control -> rules.truth_policy: "must obey"
components.control -> rules.idempotency_policy: "must obey"

storage.ingestion_assets -> components.reconciler: "effective state"
contracts.control_stream -> components.reconciler: "consume"
components.reconciler -> contracts.gap_fill_job: "enqueue"
components.reconciler -> contracts.purge_job: "enqueue"
components.reconciler -> contracts.runtime_state: "write lifecycle state"
components.reconciler -> rules.recovery_policy: "must obey"

components.ws -> components.validator: "candidate closed candle"
components.validator -> storage.ohlcv: "persist canonical candle"
components.validator -> contracts.ohlcv_stream: "publish closed candle"
components.ws -> contracts.runtime_state: "write"
components.ws -> contracts.gap_fill_job: "enqueue on recovery"
components.validator -> rules.candle_policy: "must obey"
components.validator -> rules.parity_policy: "must obey"

contracts.gap_fill_job -> components.jobs: "consume"
contracts.topup_job -> components.jobs: "scheduled consume"
contracts.depth_job -> components.jobs: "scheduled consume"
contracts.purge_job -> components.jobs: "consume"
components.jobs -> storage.ohlcv: "gap-fill / top-up"
components.jobs -> storage.l2: "depth writes"
components.jobs -> contracts.events_stream: "publish outcomes"
components.jobs -> contracts.dlq_stream: "terminal failures (target)"
components.jobs -> storage.failures: "durable failures (target)"
components.jobs -> rules.recovery_policy: "repair gaps / corrections"

contracts.lifecycle_stream -> consumers.signal_app: "consume"
contracts.lifecycle_stream -> consumers.strategy_app: "consume"
contracts.ohlcv_stream -> consumers.signal_app: "consume"
consumers.signal_app -> consumers.strategy_app: "feature outputs"
consumers.strategy_app -> consumers.risk_app: "trade intents"
consumers.risk_app -> consumers.execution_app: "approved orders"
contracts.events_stream -> consumers.operators: "observe"
contracts.dlq_stream -> consumers.operators: "investigate"

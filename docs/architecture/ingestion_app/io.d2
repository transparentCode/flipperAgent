direction: right

title: {
  label: "ingestion_app IO and contract map"
  near: top-center
}

classes: {
  source: { style.fill: "#E8F1FF" }
  component: { style.fill: "#EEF7EA" }
  contract: { style.fill: "#FFF2D8" }
  storage: { style.fill: "#F4EAFE" }
  consumer: { style.fill: "#FCE8E8" }
  rule: { style.fill: "#F3FAEF" }
}

sources: {
  label: "Inputs"

  config_global: {
    class: source
    label: "configs/ingestion/global.yaml\ningestion:*"
    shape: document
    link: "../../../configs/ingestion/global.yaml"
  }

  config_assets: {
    class: source
    label: "configs/ingestion/assets/*.yaml\ningestion.assets.*"
    shape: document
    link: "../../../configs/ingestion/assets/BTC.yaml"
  }

  control: {
    class: source
    label: "FastAPI control requests"
    shape: document
    link: "../../../src/apps/ingestion_app/api/routes.py"
  }

  ws: {
    class: source
    label: "Binance Futures finalized klines"
    shape: queue
  }

  rest: {
    class: source
    label: "Binance native REST / CCXT history"
    shape: queue
  }
}

components: {
  label: "Processing"

  settings: {
    class: component
    label: "typed settings"
    link: "../../../src/apps/ingestion_app/settings.py"
  }

  config_service: {
    class: component
    label: "AssetConfigService"
    link: "../../../src/apps/ingestion_app/services/config_reconciliation.py"
  }

  controller: {
    class: component
    label: "RuntimeController"
    link: "../../../src/apps/ingestion_app/runtime/controller.py"
  }

  supervisor: {
    class: component
    label: "RuntimeSupervisor"
    link: "../../../src/apps/ingestion_app/runtime/supervisor.py"
  }

  websocket: {
    class: component
    label: "BinanceWebSocketManager"
    link: "../../../src/apps/ingestion_app/runtime/websocket.py"
  }

  recovery: {
    class: component
    label: "RecoveryEngine"
    link: "../../../src/apps/ingestion_app/services/recovery.py"
  }

  canonicalize: {
    class: component
    label: "CandleIngestionService"
    link: "../../../src/apps/ingestion_app/services/candle_ingestion.py"
  }

  htf: {
    class: component
    label: "HTFAggregationService"
    link: "../../../src/apps/ingestion_app/services/htf_aggregation.py"
  }

  repository: {
    class: component
    label: "CandleRepository"
    link: "../../../src/apps/ingestion_app/storage/repository.py"
  }

  publisher: {
    class: component
    label: "OutboxPublisher"
    link: "../../../src/apps/ingestion_app/publication/publisher.py"
  }

  lifecycle: {
    class: component
    label: "AssetLifecycleReconciler"
    link: "../../../src/apps/ingestion_app/services/asset_lifecycle.py"
  }

  retention: {
    class: component
    label: "RetentionJanitor"
    link: "../../../src/apps/ingestion_app/services/retention.py"
  }
}

contracts: {
  label: "Domain / Transport Contracts"

  market_lane: {
    class: contract
    label: "MarketLane\nvenue + instrument + timeframe"
    shape: document
  }

  observation: {
    class: contract
    label: "CandleObservation\nprovider sourced"
    shape: document
  }

  canonical: {
    class: contract
    label: "CanonicalCandle\nprovider or derived"
    shape: document
  }

  recovery_request: {
    class: contract
    label: "RecoveryRequest\naligned [since, until)"
    shape: document
  }

  outbox_event: {
    class: contract
    label: "candle.committed v1\nproducer=ingestion"
    shape: document
  }

  ohlcv_stream: {
    class: contract
    label: "stream:ohlcv:ingestion:{venue}:{instrument_id}:{tf}"
    shape: queue
  }

  asset_hash: {
    class: contract
    label: "asset:{symbol}\nasset:{symbol}:tf:{tf}"
    shape: stored_data
  }

  lifecycle_stream: {
    class: contract
    label: "asset:lifecycle\nsource=ingestion"
    shape: queue
  }
}

storage: {
  label: "TimescaleDB"

  candles: {
    class: storage
    label: "ingestion.candles\nPK=(venue,instrument_id,timeframe,open_time)"
    shape: cylinder
  }

  outbox: {
    class: storage
    label: "ingestion.outbox\npending iff published_at IS NULL"
    shape: cylinder
  }
}

rules: {
  label: "Operating Rules"

  utc: {
    class: rule
    label: "UTC + explicit alignment origin"
  }

  base_htf: {
    class: rule
    label: "provider 1m base -> complete derived HTFs"
  }

  conflict: {
    class: rule
    label: "same key + different canonical content = CONFLICT"
  }

  transaction: {
    class: rule
    label: "new candle + outbox insert = one DB transaction"
  }

  delivery: {
    class: rule
    label: "Valkey delivery = at least once\nmark published only after XADD"
  }

  history: {
    class: rule
    label: "Timescale = historical authority\nValkey = bounded transport"
  }

  recovery_bound: {
    class: rule
    label: "bounded pages + retries + lane lock + global concurrency"
  }

  retention_rule: {
    class: rule
    label: "retention deletes published outbox only\npending rows survive"
  }
}

consumers: {
  label: "Consumers"

  signal_live: {
    class: consumer
    label: "signal_app live workers"
  }

  signal_history: {
    class: consumer
    label: "signal_app Timescale primer"
  }

  downstream_lifecycle: {
    class: consumer
    label: "signal_app / alert_app lifecycle"
  }
}

sources.config_global -> components.settings: "load"
sources.config_assets -> components.settings: "register directory"
sources.control -> components.config_service: "create / patch assets"
sources.control -> components.controller: "pause / resume / reconnect / recover"
sources.ws -> components.websocket: "finalized base klines"
sources.rest -> components.recovery: "historical pages"

components.settings -> components.controller: "validated runtime composition"
components.config_service -> components.settings: "reload"
components.config_service -> components.controller: "atomic settings replacement"
components.config_service -> components.lifecycle: "mark dirty"
components.controller -> components.supervisor: "start / replace / control"
components.websocket -> contracts.observation: "emit"
contracts.observation -> components.supervisor: "live input"
components.supervisor -> components.canonicalize: "base commit"
components.supervisor -> components.htf: "base candle"
components.supervisor -> contracts.recovery_request: "startup / interruption / HTF gaps"
contracts.recovery_request -> components.recovery: "recover"
components.recovery -> components.canonicalize: "recovered provider observations"
components.recovery -> components.htf: "affected HTF reconciliation"
components.htf -> components.repository: "read complete constituents"
components.htf -> contracts.canonical: "derived candle"
contracts.canonical -> components.canonicalize: "commit derived"
components.canonicalize -> components.repository: "INSERTED / DUPLICATE / CONFLICT"
components.repository -> storage.candles: "canonical read/write"
components.repository -> storage.outbox: "atomic new-event write"
storage.outbox -> components.publisher: "ordered pending batch"
components.publisher -> contracts.outbox_event: "encode fields"
contracts.outbox_event -> contracts.ohlcv_stream: "XADD"
contracts.ohlcv_stream -> consumers.signal_live: "consumer group"
storage.candles -> consumers.signal_history: "history query"
components.lifecycle -> contracts.asset_hash: "sync manifests"
components.lifecycle -> contracts.lifecycle_stream: "publish transition"
contracts.lifecycle_stream -> consumers.downstream_lifecycle: "consume"
components.retention -> storage.outbox: "bounded old published delete"
components.retention -> storage.candles: "drop old chunks"

rules.utc -> components.settings
rules.utc -> components.recovery
rules.utc -> components.htf
rules.base_htf -> components.supervisor
rules.base_htf -> components.htf
rules.conflict -> components.repository
rules.transaction -> components.repository
rules.delivery -> components.publisher
rules.history -> storage.candles
rules.history -> contracts.ohlcv_stream
rules.recovery_bound -> components.recovery
rules.retention_rule -> components.retention

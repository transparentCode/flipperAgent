direction: right

title: {
  label: "ingestion_app IO and contract map"
  near: top-center
}

classes: {
  source: { style.fill: "#E8F1FF" }
  component: { style.fill: "#EEF7EA" }
  contract: { style.fill: "#FFF2D8" }
  storage: { style.fill: "#F4EAFE" }
  consumer: { style.fill: "#FCE8E8" }
  rule: { style.fill: "#F3FAEF" }
}

sources: {
  label: "Inputs"

  config_global: {
    class: source
    label: "configs/ingestion/global.yaml\ningestion:*"
    shape: document
    link: "../../../configs/ingestion/global.yaml"
  }

  config_assets: {
    class: source
    label: "configs/ingestion/assets/*.yaml\ningestion.assets.*"
    shape: document
    link: "../../../configs/ingestion/assets/BTC.yaml"
  }

  control: {
    class: source
    label: "FastAPI control requests"
    shape: document
    link: "../../../src/apps/ingestion_app/api/routes.py"
  }

  ws: {
    class: source
    label: "Binance Futures finalized klines"
    shape: queue
  }

  rest: {
    class: source
    label: "Binance native REST / CCXT history"
    shape: queue
  }
}

components: {
  label: "Processing"

  settings: {
    class: component
    label: "typed settings"
    link: "../../../src/apps/ingestion_app/settings.py"
  }

  planning: {
    class: component
    label: "pure compile_ingestion_plan\nIngestionPlan + LanePlan"
    link: "../../../src/apps/ingestion_app/planning.py"
  }

  provider_factory: {
    class: component
    label: "provider factory\nvalidate + construct"
    link: "../../../src/apps/ingestion_app/providers/factory.py"
  }

  provider_quiescence: {
    class: component
    label: "historical provider idle barrier\nunique owned providers"
    link: "../../../src/apps/ingestion_app/providers/factory.py"
  }

  rest_decoder: {
    class: component
    label: "Binance REST row decoders\nadapter-specific order"
    link: "../../../src/apps/ingestion_app/providers/binance_rest.py"
  }

  config_service: {
    class: component
    label: "AssetConfigService"
    link: "../../../src/apps/ingestion_app/services/config_reconciliation.py"
  }

  controller: {
    class: component
    label: "RuntimeController\nsole desired-state owner"
    link: "../../../src/apps/ingestion_app/runtime/controller.py"
  }

  runtime_state: {
    class: component
    label: "runtime/state.py\npublic + observed state contracts"
    link: "../../../src/apps/ingestion_app/runtime/state.py"
  }

  supervisor: {
    class: component
    label: "RuntimeSupervisor\none-generation observed runner"
    link: "../../../src/apps/ingestion_app/runtime/supervisor.py"
  }

  websocket: {
    class: component
    label: "BinanceWebSocketManager\ncausal per-lane silence watchdog"
    link: "../../../src/apps/ingestion_app/runtime/websocket.py"
  }

  websocket_session: {
    class: component
    label: "Binance websocket SDK\nsession lifecycle"
    link: "../../../src/apps/ingestion_app/runtime/websocket_session.py"
  }

  websocket_bridge: {
    class: component
    label: "bounded callback bridge\nthread -> event loop"
    link: "../../../src/apps/ingestion_app/runtime/websocket_bridge.py"
  }

  websocket_sequence: {
    class: component
    label: "live sequence/liveness tracker\nconsumed progress + recovery"
    link: "../../../src/apps/ingestion_app/runtime/websocket_sequence.py"
  }

  websocket_decoder: {
    class: component
    label: "Binance websocket\npayload decoder"
    link: "../../../src/apps/ingestion_app/runtime/binance_websocket_decode.py"
  }

  recovery: {
    class: component
    label: "RecoveryEngine"
    link: "../../../src/apps/ingestion_app/services/recovery.py"
  }

  canonicalize: {
    class: component
    label: "CandleIngestionService"
    link: "../../../src/apps/ingestion_app/services/candle_ingestion.py"
  }

  htf: {
    class: component
    label: "HTFAggregationService"
    link: "../../../src/apps/ingestion_app/services/htf_aggregation.py"
  }

  repository: {
    class: component
    label: "CandleRepository"
    link: "../../../src/apps/ingestion_app/storage/repository.py"
  }

  publisher: {
    class: component
    label: "OutboxPublisher"
    link: "../../../src/apps/ingestion_app/publication/publisher.py"
  }

  lifecycle: {
    class: component
    label: "AssetLifecycleReconciler"
    link: "../../../src/apps/ingestion_app/services/asset_lifecycle.py"
  }

  retention: {
    class: component
    label: "RetentionJanitor"
    link: "../../../src/apps/ingestion_app/services/retention.py"
  }
}

contracts: {
  label: "Domain / Transport Contracts"

  market_lane: {
    class: contract
    label: "MarketLane\nvenue + instrument + timeframe"
    shape: document
  }

  observation: {
    class: contract
    label: "CandleObservation\nprovider sourced"
    shape: document
  }

  canonical: {
    class: contract
    label: "CanonicalCandle\nprovider or derived"
    shape: document
  }

  recovery_request: {
    class: contract
    label: "RecoveryRequest\naligned [since, until)"
    shape: document
  }

  outbox_event: {
    class: contract
    label: "candle.committed v1\nproducer=ingestion"
    shape: document
  }

  ohlcv_stream: {
    class: contract
    label: "stream:ohlcv:ingestion:{venue}:{instrument_id}:{tf}"
    shape: queue
  }

  asset_hash: {
    class: contract
    label: "asset:{symbol}\nasset:{symbol}:tf:{tf}"
    shape: stored_data
  }

  lifecycle_stream: {
    class: contract
    label: "asset:lifecycle\nsource=ingestion"
    shape: queue
  }
}

storage: {
  label: "TimescaleDB"

  candles: {
    class: storage
    label: "ingestion.candles\nPK=(venue,instrument_id,timeframe,open_time)"
    shape: cylinder
  }

  outbox: {
    class: storage
    label: "ingestion.outbox\npending iff published_at IS NULL"
    shape: cylinder
  }
}

rules: {
  label: "Operating Rules"

  utc: {
    class: rule
    label: "UTC + explicit alignment origin"
  }

  base_htf: {
    class: rule
    label: "configured base timeframe (currently 1m) -> complete derived HTFs"
  }

  conflict: {
    class: rule
    label: "same key + different canonical content = CONFLICT"
  }

  transaction: {
    class: rule
    label: "new candle + outbox insert = one DB transaction"
  }

  delivery: {
    class: rule
    label: "Valkey delivery = at least once\nmark published only after XADD"
  }

  history: {
    class: rule
    label: "Timescale = historical authority\nValkey = bounded transport"
  }

  recovery_bound: {
    class: rule
    label: "RecoveryEngine-owned BFS closure\ndeterministic chunks <= max_concurrency\nsemaphore + lane lock + bounded pages/retries"
  }

  retention_rule: {
    class: rule
    label: "retention deletes published outbox only\npending rows survive"
  }

  broker_startup: {
    class: rule
    label: "broker connect -> bind manifest store\n-> reconcile_all -> start lifecycle -> start publisher"
  }

  config_deployment: {
    class: rule
    label: "Compose root read-only\nbroad /app/configs bind ro\nnested /app/configs/ingestion/assets bind rw\nexisting atomic asset YAML path"
  }

  generation_fence: {
    class: rule
    label: "stop predecessor -> await provider ownership idle\nthen admit fresh generation\nquiescence deadline = fatal sticky quarantine"
  }
}

consumers: {
  label: "Consumers"

  decision_live: {
    class: consumer
    label: "decision_app\ncanonical ingestion stream parser"
    link: "../decision_app/README.md"
  }

  decision_history: {
    class: consumer
    label: "decision_app\nread-only ingestion.candles history"
    link: "../decision_app/README.md"
  }

  decision_lifecycle: {
    class: consumer
    label: "decision_app\nmanifest/lifecycle gating"
    link: "../decision_app/README.md"
  }

  alert_lifecycle: {
    class: consumer
    label: "alert_app\nlifecycle consumer"
    link: "../alert_app/README.md"
  }

  risk_lifecycle: {
    class: consumer
    label: "risk_app\nmanifest/lifecycle consumer"
    link: "../../../src/apps/risk_app/runtime/runner.py"
  }
}

sources.config_global -> components.settings: "load"
sources.config_assets -> components.settings: "register directory"
sources.control -> components.config_service: "create / patch assets"
sources.control -> components.controller: "pause / resume / reconnect / recover"
sources.ws -> components.websocket: "finalized base klines"
sources.ws -> components.websocket_decoder: "raw finalized payload"
sources.rest -> components.rest_decoder: "historical rows"
components.rest_decoder -> components.recovery: "provider observations"

components.settings -> components.provider_factory: "validated provider refs"
components.provider_factory -> components.recovery: "owned historical providers"
components.provider_factory -> components.provider_quiescence: "owned provider mapping"
components.settings -> components.planning: "typed runtime settings"
components.provider_factory -> components.planning: "composed provider ownership"
components.planning -> components.controller: "immutable initial/candidate plan"
components.config_service -> components.settings: "reload"
components.config_service -> components.controller: "atomic settings replacement"
components.config_service -> components.lifecycle: "mark dirty"
components.controller -> components.runtime_state: "compose desired + observed public snapshot"
components.supervisor -> components.runtime_state: "observed SupervisorSnapshot"
components.controller -> components.supervisor: "install / start / stop generation"
components.controller -> components.provider_quiescence: "fence fresh historical admission"
components.provider_quiescence -> components.controller: "idle or TransportDeadlineExceeded"
components.websocket_session -> components.websocket: "one SDK session / batch / cleanup"
components.websocket -> components.websocket_session: "SDK callbacks"
components.websocket -> components.websocket_bridge: "bounded callback events"
components.websocket -> components.websocket_sequence: "classify / post-yield record / watchdog"
components.websocket -> components.websocket_decoder: "raw payload"
components.websocket_decoder -> contracts.observation: "emit"
contracts.observation -> components.supervisor: "live input"
components.supervisor -> components.canonicalize: "base commit"
components.supervisor -> components.htf: "base candle"
components.supervisor -> contracts.recovery_request: "startup / interruption / HTF gaps"
contracts.recovery_request -> components.recovery: "recover_closure(plan)"
components.recovery -> components.canonicalize: "recovered provider observations"
components.recovery -> components.htf: "affected HTF reconciliation"
components.htf -> components.repository: "read complete constituents"
components.htf -> contracts.canonical: "derived candle"
contracts.canonical -> components.canonicalize: "commit derived"
components.canonicalize -> components.repository: "INSERTED / DUPLICATE / CONFLICT"
components.repository -> storage.candles: "canonical read/write"
components.repository -> storage.outbox: "atomic new-event write"
storage.outbox -> components.publisher: "ordered pending batch"
components.publisher -> contracts.outbox_event: "encode fields"
contracts.outbox_event -> contracts.ohlcv_stream: "XADD"
contracts.ohlcv_stream -> consumers.decision_live: "bounded direct XREAD cursor / parser"
storage.candles -> consumers.decision_history: "read-only history query"
components.lifecycle -> contracts.asset_hash: "sync manifests"
components.lifecycle -> contracts.lifecycle_stream: "publish transition"
contracts.asset_hash -> consumers.decision_lifecycle: "manifest gating"
contracts.asset_hash -> consumers.risk_lifecycle: "availability gating"
contracts.lifecycle_stream -> consumers.decision_lifecycle: "notification"
contracts.lifecycle_stream -> consumers.alert_lifecycle: "consume / normalize"
contracts.lifecycle_stream -> consumers.risk_lifecycle: "consume / apply"
components.retention -> storage.outbox: "bounded old published delete"
components.retention -> storage.candles: "drop old chunks"

rules.utc -> components.settings
rules.utc -> components.recovery
rules.utc -> components.htf
rules.base_htf -> components.supervisor
rules.base_htf -> components.htf
rules.conflict -> components.repository
rules.transaction -> components.repository
rules.delivery -> components.publisher
rules.history -> storage.candles
rules.history -> contracts.ohlcv_stream
rules.recovery_bound -> components.recovery
rules.retention_rule -> components.retention
rules.broker_startup -> components.lifecycle: "bind -> reconcile_all -> start"
rules.broker_startup -> components.publisher: "start after lifecycle"
rules.config_deployment -> components.config_service: "P1B narrow writable asset mount"
rules.generation_fence -> components.provider_quiescence
rules.generation_fence -> components.controller

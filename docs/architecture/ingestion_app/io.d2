direction: right

title: {
  label: "ingestion_app IO contracts"
  near: top-center
}

classes: {
  source: { style.fill: "#E8F1FF" }
  component: { style.fill: "#EEF7EA" }
  contract: { style.fill: "#FFF2D8" }
  storage: { style.fill: "#F4EAFE" }
  consumer: { style.fill: "#FCE8E8" }
}

sources: {
  label: "Inputs"

  lifecycle_request: {
    class: source
    label: "asset lifecycle request"
    shape: document
    link: "../../../src/apps/ingestion_app/models/asset_registry.py"
  }

  live_feed: {
    class: source
    label: "Binance live kline"
    link: "../../../src/apps/ingestion_app/adapters/binance_native.py"
  }

  historical_feed: {
    class: source
    label: "historical OHLCV / depth"
    link: "../../../src/apps/ingestion_app/adapters/crypto_ccxt.py"
  }
}

components: {
  label: "Components"

  router: {
    class: component
    label: "ingestion_router"
    link: "../../../src/apps/api_app/routers/ingestion.py"
  }

  runtime_app: {
    class: component
    label: "runtime_app"
    link: "../../../src/apps/ingestion_app/runtime/app.py"
  }

  control: {
    class: component
    label: "control_plane"
    link: "../../../src/apps/ingestion_app/control_plane/service.py"
  }

  reconciler: {
    class: component
    label: "runtime_reconciler"
    link: "../../../src/apps/ingestion_app/runtime/reconciler.py"
  }

  ws: {
    class: component
    label: "websocket_pipeline"
    link: "../../../src/apps/ingestion_app/runtime/websocket.py"
  }

  jobs: {
    class: component
    label: "queue_jobs"
    link: "../../../src/apps/ingestion_app/worker.py"
  }
}

contracts: {
  label: "Valkey / Job Contracts"

  asset_manifest: {
    class: contract
    label: "asset:{symbol}"
    shape: stored_data
  }

  asset_manifest_tf: {
    class: contract
    label: "asset:{symbol}:tf:{tf}"
    shape: stored_data
  }

  lifecycle_stream: {
    class: contract
    label: "asset:lifecycle"
    shape: queue
  }

  control_stream: {
    class: contract
    label: "stream:control:ingestion"
    shape: queue
  }

  events_stream: {
    class: contract
    label: "stream:events:ingestion"
    shape: queue
  }

  ohlcv_stream: {
    class: contract
    label: "stream:ohlcv:{symbol}:{tf}"
    shape: queue
  }

  runtime_state: {
    class: contract
    label: "ingestion:state:{symbol}:{tf}"
    shape: stored_data
  }

  gap_fill_job: {
    class: contract
    label: "run_rest_gap_fill"
    shape: queue
  }

  topup_job: {
    class: contract
    label: "poll_binance_ohlcv"
    shape: queue
  }

  depth_job: {
    class: contract
    label: "poll_l2_depth"
    shape: queue
  }

  purge_job: {
    class: contract
    label: "purge_removed_asset"
    shape: queue
  }
}

storage: {
  label: "Persistence"

  ingestion_assets: {
    class: storage
    shape: cylinder
    label: "ingestion_assets"
  }

  ohlcv: {
    class: storage
    shape: cylinder
    label: "ohlcv"
  }

  l2: {
    class: storage
    shape: cylinder
    label: "l2_depth_features"
  }
}

consumers: {
  label: "Consumers"

  signal_app: {
    class: consumer
    label: "signal_app"
  }

  strategy_app: {
    class: consumer
    label: "strategy_app"
  }

  operators: {
    class: consumer
    label: "operators / future alert_app"
  }
}

sources.lifecycle_request -> components.router: "HTTP"
components.router -> components.control: "upsert / patch / action"
components.runtime_app -> components.reconciler: "startup reconcile"
sources.live_feed -> components.ws: "websocket"
sources.historical_feed -> components.jobs: "REST"

components.control -> storage.ingestion_assets: "persist registry"
components.control -> contracts.asset_manifest: "write"
components.control -> contracts.asset_manifest_tf: "write"
components.control -> contracts.lifecycle_stream: "publish"
components.control -> contracts.control_stream: "publish"
components.control -> contracts.events_stream: "publish"

storage.ingestion_assets -> components.reconciler: "effective state"
contracts.control_stream -> components.reconciler: "consume"
components.reconciler -> contracts.gap_fill_job: "enqueue"
components.reconciler -> contracts.purge_job: "enqueue"
components.reconciler -> contracts.runtime_state: "write lifecycle state"

components.ws -> storage.ohlcv: "persist live"
components.ws -> contracts.ohlcv_stream: "publish"
components.ws -> contracts.runtime_state: "write"
components.ws -> contracts.gap_fill_job: "enqueue on recovery"

contracts.gap_fill_job -> components.jobs: "consume"
contracts.topup_job -> components.jobs: "scheduled consume"
contracts.depth_job -> components.jobs: "scheduled consume"
contracts.purge_job -> components.jobs: "consume"
components.jobs -> storage.ohlcv: "gap-fill / top-up"
components.jobs -> storage.l2: "depth writes"
components.jobs -> contracts.events_stream: "publish outcomes"

contracts.lifecycle_stream -> consumers.signal_app: "consume"
contracts.lifecycle_stream -> consumers.strategy_app: "consume"
contracts.ohlcv_stream -> consumers.signal_app: "consume"
contracts.events_stream -> consumers.operators: "observe"

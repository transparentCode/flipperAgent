r4c -> abcd: "four alternating anchors\nordinal legs"
r4c -> xabcd: "five alternating anchors\nordinal legs + ratios"
r4c -> head_shoulders: "five extrema\nbar-coordinate neckline"
r4c -> triangle: "four extrema\nexact boundary intersection"
r4c -> native: "validate, then call once"
r4c -> taxonomy: "available pattern tools\nfuture families remain planned"
r4d: "R4D advanced pattern\ngeometry kernels"
cypher: "Cypher\nratios, no classifier"
three_drives: "Three Drives\nprice/time measurements"
elliott_impulse: "Elliott Impulse\nwave measurements"

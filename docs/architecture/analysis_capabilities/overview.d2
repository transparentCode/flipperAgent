direction: right

caller: "caller"
metadata: "metadata catalog + invocation specs"
source: "external R3 source adapter\n(outside R2)"
canonical: "R3 canonical source slice\nimmutable + hashed"
requests: "R3 named request adapters\nexplicit identity/range"
attestation: "source attestation +\nPIT invocation context"
bound: "R2 bound executor\nexplicit dispatch"
native: "existing capability dispatcher\n(native request/result)"
postcheck: "R2 post-execution\ncutoff / identity / source checks"
result: "provenance envelope\n(native result retained)"
projection: "R3 factual projection\nsource-attested results"
tvlc: "existing TVLC 5.2.1\ninline renderer"
provider: "provider / DB source\noutside R3 execution"

caller -> metadata: "discover / select"
caller -> source: "canonical source mapping\nR3 responsibility"
source -> attestation: "host-attested identity\nand timestamps"
provider -> source: "records supplied by caller\nno R3 acquisition"
source -> canonical: "validate continuity, provenance,\ngrid, availability"
canonical -> requests: "same hashed record slice"
requests -> bound: "named native request"
metadata -> bound: "static spec"
attestation -> bound: "source + context"
bound -> native: "validate, then call once"
native -> postcheck: "native result"
postcheck -> result: "reconciled provenance"
result -> projection: "five native results\none source + cutoff"
projection -> tvlc: "candles + factual overlays"
r4a: "R4A deterministic toolbox\nthree explicit stateless kernels"
taxonomy: "machine-readable toolbox taxonomy\nseparate from callable catalog"
recommender: "future recommender boundary\nsuggestions only"
caller -> r4a: "explicit request"
r4a -> native: "parallel / Fibonacci / AVWAP\nvalidate, then call once"
r4a -> taxonomy: "vocabulary and status"
recommender -> r4a: "may suggest\nkernels remain authoritative"
r4b: "R4B deterministic Gann +\nvolume-profile kernels"
gann_fan: "Gann Fan\nbar ordinal + explicit scale"
gann_box: "Gann Box\nprice/time fraction grid"
volume_profile: "Volume Profile\nexplicit supplied bars"
caller -> r4b: "explicit request\nno hidden source"
r4b -> gann_fan: "one causal anchor\nprice-per-bar scale"
r4b -> gann_box: "two coordinates\ncaller partitions"
r4b -> volume_profile: "uniform overlap\nPOC + contiguous VA"
volume_profile -> native: "one shared kernel\nfixed/anchored range modes"
r4b -> taxonomy: "available tools\nGann + volume"
r4c: "R4C explicit pattern\ngeometry kernels"
abcd: "ABCD\nexplicit four anchors"
xabcd: "XABCD\nratios, no classifier"
head_shoulders: "Head & Shoulders\nneckline + prominence"
triangle: "Triangle\nboundaries + apex"

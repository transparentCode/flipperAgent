direction: right

title: {
  label: "signal_app IO contracts"
  near: top-center
}

classes: {
  source: { style.fill: "#E8F1FF" }
  component: { style.fill: "#EEF7EA" }
  contract: { style.fill: "#FFF2D8" }
  storage: { style.fill: "#F4EAFE" }
  consumer: { style.fill: "#FCE8E8" }
}

sources: {
  label: "Inputs"

  canonical: {
    class: source
    label: "asset manifest / lifecycle"
    shape: stored_data
  }

  ohlcv_stream_in: {
    class: source
    label: "stream:ohlcv:ingestion:{venue}:{instrument_id}:{tf}"
    shape: queue
  }

  historical_bars: {
    class: source
    label: "historical OHLCV"
    shape: cylinder
  }

  context_hashes: {
    class: source
    label: "index / derivatives hashes"
    shape: stored_data
  }

  snapshot_request: {
    class: source
    label: "snapshot request"
    shape: document
  }
}

components: {
  label: "Components"

  bootstrap: {
    class: component
    label: "main bootstrap"
    link: "../../../src/apps/signal_app/main.py"
  }

  runner: {
    class: component
    label: "runtime_runner"
    link: "../../../src/apps/signal_app/runtime/runner.py"
  }

  worker: {
    class: component
    label: "runtime_worker"
    link: "../../../src/apps/signal_app/runtime/worker.py"
  }

  pipeline: {
    class: component
    label: "feature_pipeline"
    link: "../../../src/apps/signal_app/pipeline/features.py"
  }

  publisher: {
    class: component
    label: "publishers"
    link: "../../../src/apps/signal_app/publishing/streams.py"
  }

  observability: {
    class: component
    label: "observability"
    link: "../../../src/apps/signal_app/observability/status.py"
  }
}

contracts: {
  label: "Valkey Contracts"

  lifecycle_stream: {
    class: contract
    label: "asset:lifecycle"
    shape: queue
  }

  feature_stream: {
    class: contract
    label: "features:{symbol}:{tf}"
    shape: queue
  }

  price_stream: {
    class: contract
    label: "price_update:{symbol}:{tf}"
    shape: queue
  }

  runtime_status: {
    class: contract
    label: "signal:status:{symbol}:{tf}"
    shape: stored_data
  }
}

storage: {
  label: "Persistence"

  ohlcv: {
    class: storage
    label: "ohlcv"
    shape: cylinder
  }

  l2: {
    class: storage
    label: "l2_depth_features"
    shape: cylinder
  }
}

consumers: {
  label: "Consumers"

  strategy: {
    class: consumer
    label: "strategy_app"
  }

  risk: {
    class: consumer
    label: "risk_app"
  }
}

sources.canonical -> components.bootstrap: "list_runtime_pairs"
sources.canonical -> contracts.lifecycle_stream: "published by ingestion"
contracts.lifecycle_stream -> components.runner: "consume"
sources.ohlcv_stream_in -> components.worker: "closed candles"
sources.historical_bars -> components.pipeline: "prime / snapshot"
sources.context_hashes -> components.pipeline: "enrich"
sources.snapshot_request -> components.pipeline: "compute"

components.bootstrap -> components.runner: "start runtime"
components.runner -> components.worker: "worker lifecycle"
components.worker -> components.pipeline: "bar input"
components.worker -> components.observability: "state / errors"
components.pipeline -> components.publisher: "FeatureVector / PriceUpdate"
components.observability -> contracts.runtime_status: "write"

storage.ohlcv -> components.pipeline: "read"
storage.l2 -> components.pipeline: "optional read"
components.publisher -> contracts.feature_stream: "publish"
components.publisher -> contracts.price_stream: "publish"
contracts.feature_stream -> consumers.strategy: "consume"
contracts.price_stream -> consumers.risk: "consume"

direction: right

title: {
  label: "signal_app architecture"
  near: top-center
}

inputs: {
  label: "Inputs"
  style.fill: "#E8F1FF"

  ingestion_stream: {
    label: "stream:ohlcv:ingestion:{venue}:{instrument_id}:{tf}"
    link: "../../../src/apps/ingestion_app/runtime/websocket.py"
  }

  asset_manifest: {
    label: "asset:* + asset:lifecycle"
    link: "../../../src/libs/common/asset_manifest.py"
  }

  history: {
    label: "ingestion.candles"
    link: "../../../src/apps/ingestion_app/storage/repository.py"
  }

  context_hashes: {
    label: "index / derivatives hashes"
    link: "../../../configs/tradingview.yaml"
  }

  api_client: {
    label: "api_app / research CLI"
    link: "../../../src/apps/signal_app/api/routes.py"
  }
}

signal_app: {
  label: "signal_app"
  style.fill: "#EEF7EA"
  link: "./README.md"

  worker_runtime: {
    label: "main bootstrap"
    link: "../../../src/apps/signal_app/main.py"
  }

  pair_catalog: {
    label: "pair_catalog"
    link: "../../../src/apps/signal_app/catalog/pairs.py"
  }

  runtime_runner: {
    label: "runtime_runner"
    link: "../../../src/apps/signal_app/runtime/runner.py"
  }

  runtime_worker: {
    label: "runtime_worker"
    link: "../../../src/apps/signal_app/runtime/worker.py"
  }

  feature_pipeline: {
    label: "feature_pipeline"
    link: "../../../src/apps/signal_app/pipeline/features.py"
  }

  enrichment: {
    label: "enrichment"
    link: "../../../src/apps/signal_app/enrichment/valkey.py"
  }

  publishers: {
    label: "publishers"
    link: "../../../src/apps/signal_app/publishing/streams.py"
  }

  observability: {
    label: "observability"
    link: "../../../src/apps/signal_app/observability/status.py"
  }

  api: {
    label: "signal_api"
    link: "../../../src/apps/signal_app/api/routes.py"
  }
}

valkey: {
  label: "Valkey"
  style.fill: "#FFF2D8"

  lifecycle: {
    label: "asset:lifecycle"
    link: "../../../src/libs/common/asset_manifest.py"
  }

  feature_stream: {
    label: "features:{symbol}:{tf}"
    link: "../../../src/apps/signal_app/publishing/streams.py"
  }

  price_stream: {
    label: "price_update:{symbol}:{tf}"
    link: "../../../src/apps/signal_app/publishing/streams.py"
  }

  runtime_state: {
    label: "signal:status:{symbol}:{tf}"
    link: "../../../src/apps/signal_app/observability/runtime_state.py"
  }
  context: { label: "market context hashes" }
}

timescaledb: {
  label: "TimescaleDB"
  style.fill: "#F4EAFE"

  ohlcv: {
    label: "ingestion.candles"
    link: "../../../src/apps/ingestion_app/storage/repository.py"
  }

  l2: {
    label: "l2_depth_features"
    link: "../../../src/libs/common/db/timescale_reader.py"
  }
}

downstream: {
  label: "Downstream"
  style.fill: "#FCE8E8"

  strategy_app: {
    label: "strategy_app"
    link: "../strategy_app/README.md"
  }

  risk_app: {
    label: "risk_app"
    link: "../../../src/apps/risk_app/risk_worker.py"
  }
}

inputs.asset_manifest -> signal_app.worker_runtime: "bootstrap pairs"
inputs.asset_manifest -> signal_app.runtime_runner: "lifecycle subscription"
inputs.ingestion_stream -> signal_app.runtime_worker: "closed candles / gap detection"
inputs.history -> signal_app.feature_pipeline: "priming / snapshot"
inputs.context_hashes -> signal_app.enrichment: "read"
inputs.api_client -> signal_app.api: "HTTP / CLI"

signal_app.worker_runtime -> signal_app.pair_catalog: "resolve pairs"
signal_app.worker_runtime -> signal_app.runtime_runner: "start"
signal_app.pair_catalog -> signal_app.runtime_runner: "effective pairs"
signal_app.runtime_runner -> signal_app.runtime_worker: "start / stop / remove workers"
signal_app.runtime_worker -> signal_app.feature_pipeline: "closed bar"
signal_app.feature_pipeline -> signal_app.enrichment: "market context"
signal_app.feature_pipeline -> signal_app.publishers: "feature + price payloads"
signal_app.runtime_worker -> signal_app.observability: "live / degraded / failed state"
signal_app.api -> signal_app.observability: "latest / status"
signal_app.api -> signal_app.feature_pipeline: "on-demand snapshot"

signal_app.enrichment -> valkey.context: "read"
signal_app.observability -> valkey.runtime_state: "write"
signal_app.publishers -> valkey.feature_stream: "publish"
signal_app.publishers -> valkey.price_stream: "publish"

timescaledb.ohlcv -> signal_app.feature_pipeline: "history reads"
timescaledb.l2 -> signal_app.feature_pipeline: "optional enrichment"
valkey.feature_stream -> downstream.strategy_app: "consume"
valkey.price_stream -> downstream.risk_app: "consume"

direction: right

title: {
  label: "strategy_app IO contracts"
  near: top-center
}

classes: {
  source: { style.fill: "#E8F1FF" }
  component: { style.fill: "#EEF7EA" }
  contract: { style.fill: "#FFF2D8" }
  consumer: { style.fill: "#FCE8E8" }
}

sources: {
  label: "Inputs"

  canonical: {
    class: source
    label: "asset manifest / lifecycle"
    shape: stored_data
  }

  feature_stream_in: {
    class: source
    label: "features:{symbol}:{tf}"
    shape: queue
  }

  control_request: {
    class: source
    label: "pause / resume request"
    shape: document
  }
}

components: {
  label: "Components"

  bootstrap: {
    class: component
    label: "main bootstrap"
    link: "../../../src/apps/strategy_app/main.py"
  }

  runner: {
    class: component
    label: "runtime_runner"
    link: "../../../src/apps/strategy_app/runtime/runner.py"
  }

  worker: {
    class: component
    label: "runtime_worker"
    link: "../../../src/apps/strategy_app/runtime/worker.py"
  }

  evaluation: {
    class: component
    label: "evaluation_service"
    link: "../../../src/apps/strategy_app/evaluation/service.py"
  }

  publisher: {
    class: component
    label: "signal_publisher"
    link: "../../../src/apps/strategy_app/publishing/signals.py"
  }

  control: {
    class: component
    label: "control_store"
    link: "../../../src/apps/strategy_app/control.py"
  }

  observability: {
    class: component
    label: "observability"
    link: "../../../src/apps/strategy_app/observability/status.py"
  }
}

contracts: {
  label: "Valkey Contracts"

  lifecycle_stream: {
    class: contract
    label: "asset:lifecycle"
    shape: queue
  }

  strategy_control: {
    class: contract
    label: "strategy:control:{symbol}:{tf}"
    shape: stored_data
  }

  strategy_status: {
    class: contract
    label: "strategy:status:{symbol}:{tf}"
    shape: stored_data
  }

  signals_stream: {
    class: contract
    label: "signals:{symbol}:{tf}"
    shape: queue
  }
}

consumers: {
  label: "Consumers"

  risk: {
    class: consumer
    label: "risk_app"
  }
}

sources.canonical -> components.bootstrap: "list_runtime_pairs"
sources.canonical -> contracts.lifecycle_stream: "published by ingestion"
contracts.lifecycle_stream -> components.runner: "consume"
sources.feature_stream_in -> components.worker: "FeatureVector"
sources.control_request -> components.control: "pause / resume"

components.bootstrap -> components.runner: "start runtime"
components.runner -> components.worker: "worker lifecycle"
components.worker -> components.control: "read desired state"
components.worker -> components.evaluation: "evaluate"
components.worker -> components.observability: "status updates"
components.evaluation -> components.publisher: "selected candidates"

components.control -> contracts.strategy_control: "write"
components.observability -> contracts.strategy_status: "write"
components.publisher -> contracts.signals_stream: "publish"
contracts.signals_stream -> consumers.risk: "consume"

# Dockerfile.tv-scraper
# Separate image for TradingView index scraping — includes headless Chromium via patchright
#
# Uses the Microsoft Playwright Python base image (Ubuntu Noble, Python 3.12) which ships
# all Chromium system libraries pre-installed, eliminating fragile apt-get downloads from
# Debian mirrors at build time. patchright replaces the bundled Playwright Chromium with
# its stealth-patched version (downloads ~170 MB from playwright.azureedge.net, no apt-get).
#
# pyproject.toml requires >=3.12; all application code is Python 3.12-compatible.

FROM ghcr.io/astral-sh/uv:0.12.11 AS uv

FROM mcr.microsoft.com/playwright/python:v1.52.0-noble

WORKDIR /app

# Install the default and TradingView dependencies from the generated lock.
COPY --from=uv /uv /uvx /bin/
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --locked --no-install-project --no-dev --extra tv-scraper

# Replace the bundled Playwright Chromium with patchright's stealth-patched binary.
# No --with-deps needed — system libraries already present in the base image.
RUN python -m patchright install chromium

# Copy application code
COPY src/ ./src/
COPY configs/ ./configs/

ENV PYTHONPATH=/app/src
ENV PYTHONUNBUFFERED=1
ENV PATH="/app/.venv/bin:$PATH"

CMD ["arq", "apps.tv_scraper.worker.WorkerSettings"]

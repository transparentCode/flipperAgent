{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "title": "Runtime LIVE",
      "type": "stat",
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "ingestion_runtime_live{service_name=\"ingestion\"}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background"}
    },
    {
      "title": "WebSocket Connected",
      "type": "stat",
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "ingestion_websocket_connected{service_name=\"ingestion\"}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background"}
    },
    {
      "title": "Outbox Pending",
      "type": "gauge",
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "ingestion_outbox_pending{service_name=\"ingestion\"}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 100}, {"color": "red", "value": 1000}]}}, "overrides": []}
    },
    {
      "title": "WebSocket Queue Utilization",
      "type": "timeseries",
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "ingestion_websocket_queue_utilization{service_name=\"ingestion\"}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []}
    },
    {
      "title": "Canonical Commit Rate",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(rate(ingestion_candle_commit_total{service_name=\"ingestion\"}[5m])) by (outcome)", "legendFormat": "{{outcome}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []}
    },
    {
      "title": "Commit Conflicts (1h)",
      "type": "stat",
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 5},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(increase(ingestion_candle_commit_total{service_name=\"ingestion\",outcome=\"conflict\"}[1h]))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background"}
    },
    {
      "title": "Stalest Base Lanes",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 5},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "topk(10, time() - ingestion_base_last_close_timestamp_seconds{service_name=\"ingestion\"})", "legendFormat": "{{venue}}/{{instrument_id}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}
    },
    {
      "title": "Recovery Rate",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 13},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(rate(ingestion_recovery_total{service_name=\"ingestion\"}[5m])) by (outcome)", "legendFormat": "{{outcome}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []}
    },
    {
      "title": "Oldest Pending Outbox Age",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 13},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "(time() - ingestion_outbox_oldest_pending_timestamp_seconds{service_name=\"ingestion\"}) * (ingestion_outbox_pending{service_name=\"ingestion\"} > bool 0)", "legendFormat": "pending age", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}
    },
    {
      "title": "Outbox Publication Rate / Failures",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 21},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "rate(ingestion_outbox_publish_total{service_name=\"ingestion\"}[5m])", "legendFormat": "published", "refId": "A"},
        {"expr": "rate(ingestion_outbox_publish_failure_total{service_name=\"ingestion\"}[5m])", "legendFormat": "failed batches", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []}
    },
    {
      "title": "Recent Ingestion Logs",
      "type": "logs",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 21},
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [{"expr": "{service_name=\"ingestion\"}", "refId": "A"}]
    },
    {
      "title": "Recent Ingestion Traces",
      "type": "table",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 29},
      "datasource": {"type": "tempo", "uid": "tempo"},
      "targets": [{"queryType": "nativeSearch", "limit": 20, "refId": "A"}]
    }
  ],
  "schemaVersion": 39,
  "tags": ["flipperAgent", "ingestion", "observability"],
  "templating": {"list": []},
  "time": {"from": "now-1h", "to": "now"},
  "timezone": "browser",
  "title": "Ingestion Operations",
  "uid": "flipper-ingestion",
  "version": 1
}
